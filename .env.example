# ChatFlow Environment Variables
# Copy this to .env and fill in your values

# Port the server listens on (default: 3000)
PORT=3000

# Optional: pre-configure Twitch channel on startup
# TWITCH_CHANNEL=yourchannelname

# Optional: pre-configure YouTube on startup
# YOUTUBE_API_KEY=your_youtube_data_api_v3_key
# YOUTUBE_LIVE_CHAT_ID=your_live_chat_id

# Node environment
NODE_ENV=development
